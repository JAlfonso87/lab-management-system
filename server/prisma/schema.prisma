generator client {
  provider = "prisma-client"
  output   = "../src/.prisma"
}

datasource db {
  provider = "mysql"
}

model assigned_teachers {
  assignation_id         Int      @id @default(autoincrement())
  subject_id             Int
  teacher_id             Int
  assigned_working_hours Int
  subjects               subjects @relation(fields: [subject_id], references: [subject_id], onDelete: NoAction, onUpdate: NoAction, map: "assigned_teachers_ibfk_1")
  teachers               teachers @relation(fields: [teacher_id], references: [teacher_id], onDelete: NoAction, onUpdate: NoAction, map: "assigned_teachers_ibfk_2")

  @@index([subject_id], map: "subject_id")
  @@index([teacher_id], map: "teacher_id")
}

model labs {
  lab_id      Int           @id
  lab_name    String        @db.VarChar(30)
  locations   locations     @relation(fields: [lab_id], references: [location_id], onDelete: Cascade, onUpdate: NoAction, map: "labs_ibfk_1")
  technicians technicians[]
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model local_stocks {
  local_stock_id    Int               @id @default(autoincrement())
  reagent_id        Int
  location_id       Int
  local_stock_units Int?              @default(0)
  reagents          reagents          @relation(fields: [reagent_id], references: [reagent_id], onDelete: NoAction, onUpdate: NoAction, map: "local_stocks_ibfk_1")
  locations         locations         @relation(fields: [location_id], references: [location_id], onDelete: NoAction, onUpdate: NoAction, map: "local_stocks_ibfk_2")
  operations        operations[]
  request_details   request_details[]

  @@unique([reagent_id, location_id], map: "reagent_id")
  @@index([location_id], map: "location_id")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model locations {
  location_id       Int            @id @default(autoincrement())
  location_building String         @db.Char(1)
  location_type     String         @db.VarChar(15)
  labs              labs?
  local_stocks      local_stocks[]
  shelf_levels      shelf_levels?
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model operations {
  operation_id          Int          @id @default(autoincrement())
  reagent_id            Int
  technician_id         Int
  local_stock_id        Int
  operation_type        String       @db.VarChar(10)
  stock_difference      Int          @default(0)
  operation_date        DateTime     @db.Date
  operation_description String?      @default("DEFAULT DESCRIPTION.") @db.VarChar(150)
  reagents              reagents     @relation(fields: [reagent_id], references: [reagent_id], onDelete: NoAction, onUpdate: NoAction, map: "operations_ibfk_1")
  technicians           technicians  @relation(fields: [technician_id], references: [technician_id], onDelete: NoAction, onUpdate: NoAction, map: "operations_ibfk_2")
  local_stocks          local_stocks @relation(fields: [local_stock_id], references: [local_stock_id], onDelete: NoAction, onUpdate: NoAction, map: "operations_ibfk_3")

  @@index([local_stock_id], map: "local_stock_id")
  @@index([reagent_id], map: "reagent_id")
  @@index([technician_id], map: "technician_id")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model reagents {
  reagent_id        Int            @id @default(autoincrement())
  reagent_name      String         @db.VarChar(100)
  reagent_brand     String         @db.VarChar(20)
  reagent_netweight String         @db.VarChar(10)
  reagent_risk      String?        @db.VarChar(15)
  local_stocks      local_stocks[]
  operations        operations[]
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model request_details {
  request_details_id Int          @id @default(autoincrement())
  request_id         Int
  local_stock_id     Int
  requested_units    Int
  local_stocks       local_stocks @relation(fields: [local_stock_id], references: [local_stock_id], onDelete: NoAction, onUpdate: NoAction, map: "request_details_ibfk_1")
  requests           requests     @relation(fields: [request_id], references: [request_id], onDelete: NoAction, onUpdate: NoAction, map: "request_details_ibfk_2")

  @@index([local_stock_id], map: "local_stock_id")
  @@index([request_id], map: "request_id")
}

model requesters {
  requester_id           Int        @id @default(autoincrement())
  requester_first_name   String     @db.VarChar(30)
  requester_middle_name  String?    @db.VarChar(20)
  requester_last_name    String?    @db.VarChar(20)
  requester_phone_number String?    @db.VarChar(20)
  requests               requests[]
  teachers               teachers?
}

model requests {
  request_id      Int               @id @default(autoincrement())
  requester_id    Int
  technician_id   Int
  request_date    DateTime          @db.Date
  request_details request_details[]
  requesters      requesters        @relation(fields: [requester_id], references: [requester_id], onDelete: NoAction, onUpdate: NoAction, map: "requests_ibfk_1")
  technicians     technicians       @relation(fields: [technician_id], references: [technician_id], onDelete: NoAction, onUpdate: NoAction, map: "requests_ibfk_2")

  @@index([requester_id], map: "requester_id")
  @@index([technician_id], map: "technician_id")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model shelf_levels {
  shelf_level_id     Int       @id
  shelf_id           Int
  shelf_level_number Int
  locations          locations @relation(fields: [shelf_level_id], references: [location_id], onDelete: Cascade, onUpdate: NoAction, map: "shelf_levels_ibfk_1")
  shelves            shelves   @relation(fields: [shelf_id], references: [shelf_id], onDelete: NoAction, onUpdate: NoAction, map: "shelf_levels_ibfk_2")

  @@unique([shelf_id, shelf_level_number], map: "shelf_level_uniqueness")
}

model shelves {
  shelf_id       Int            @id @default(autoincrement())
  shelf_category String         @db.VarChar(20)
  shelf_levels   shelf_levels[]
}

model subjects {
  subject_id          Int                 @id @default(autoincrement())
  subject_name        String              @db.VarChar(30)
  subject_description String?             @db.VarChar(150)
  assigned_teachers   assigned_teachers[]
}

model teachers {
  teacher_id        Int                 @id
  assigned_teachers assigned_teachers[]
  requesters        requesters          @relation(fields: [teacher_id], references: [requester_id], onDelete: NoAction, onUpdate: NoAction, map: "teachers_ibfk_1")
  thesis_authors    thesis_authors[]
}

model technicians {
  technician_id           Int          @id @default(autoincrement())
  lab_id                  Int
  technician_first_name   String       @db.VarChar(30)
  technician_middle_name  String       @db.VarChar(20)
  technician_last_name    String?      @db.VarChar(20)
  technician_phone_number String?      @db.VarChar(20)
  technician_username     String       @unique(map: "technician_username") @db.VarChar(20)
  technician_password     String       @db.VarChar(255)
  technician_status       Int          @default(0)
  operations              operations[]
  requests                requests[]
  labs                    labs         @relation(fields: [lab_id], references: [lab_id], onDelete: NoAction, onUpdate: NoAction, map: "technicians_ibfk_1")

  @@index([lab_id], map: "lab_id")
}

model thesis_authors {
  thesis_author_id Int      @id @default(autoincrement())
  asessor_id       Int
  project_title    String   @db.VarChar(60)
  teachers         teachers @relation(fields: [asessor_id], references: [teacher_id], onDelete: NoAction, onUpdate: NoAction, map: "thesis_authors_ibfk_1")

  @@index([asessor_id], map: "asessor_id")
}
